generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Unpooled connection for migrations (pgbouncer-style poolers break
  // Prisma migrate). Locally, point this at the same URL as DATABASE_URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  projects     Project[]
  libraryItems LibraryItem[]
  icons        Icon[]
}

model Project {
  id         String      @id @default(cuid())
  userId     String
  name       String
  address    String?
  clientName String?
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sheets     Sheet[]
  conditions Condition[]
}

model Sheet {
  id                 String        @id @default(cuid())
  projectId          String
  name               String
  pageNumber         Int
  fileUrl            String
  scalePixelsPerUnit Float?
  unitSystem         String        @default("imperial") // "imperial" | "metric"
  createdAt          DateTime      @default(now())
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  measurements       Measurement[]
}

// A takeoff item ("condition" in estimating parlance) — what's being measured.
model Condition {
  id              String        @id @default(cuid())
  projectId       String
  name            String
  color           String
  measurementType String // "linear" | "area" | "count"
  unit            String
  unitCost        Float?
  iconKey         String? // storage key of a custom marker icon (count items)
  createdAt       DateTime      @default(now())
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  measurements    Measurement[]
}

// A user's reusable takeoff-item template, shared across projects.
model LibraryItem {
  id              String   @id @default(cuid())
  userId          String
  name            String
  color           String
  measurementType String // "linear" | "area" | "count"
  unit            String
  unitCost        Float?
  iconKey         String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A user-uploaded marker icon (PNG/SVG/JPEG) usable on count items.
model Icon {
  id          String   @id @default(cuid())
  userId      String
  name        String
  fileKey     String
  contentType String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Measurement {
  id            String    @id @default(cuid())
  sheetId       String
  conditionId   String
  geometry      Json // { points: [{x, y}, ...] } in PDF base coordinates (scale 1)
  computedValue Float
  source        String    @default("manual") // "manual" | "ai"
  createdAt     DateTime  @default(now())
  sheet         Sheet     @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  condition     Condition @relation(fields: [conditionId], references: [id], onDelete: Cascade)
}
