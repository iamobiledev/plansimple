{
  "name": "plansimple",
  "private": true,
  "version": "0.3.0",
  "description": "PlanSimple — cloud-native construction document collaboration",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm --filter @plansimple/web dev",
    "build": "pnpm --filter @plansimple/shared build && pnpm --filter @plansimple/web build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @plansimple/e2e test",
    "db:migrate": "pnpm --filter @plansimple/web db:migrate",
    "db:generate": "pnpm --filter @plansimple/api db:generate",
    "seed": "pnpm --filter @plansimple/web seed",
    "seed:drawings": "pnpm --filter @plansimple/api seed:drawings"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.2"
  }
}
