# PostgreSQL connection string
DATABASE_URL="postgresql://plansimple:plansimple@localhost:5432/plansimple"

# Secret used to sign session cookies — change in production
SESSION_SECRET="dev-secret-change-me"

# Anthropic API key for AI-assisted takeoff (AI Count / AI Suggest).
# The rest of the app works without it; AI features return a clear error if unset.
ANTHROPIC_API_KEY=""

# Claude model used for vision requests
ANTHROPIC_MODEL="claude-opus-4-8"

# API port (the Vite dev server proxies /api to this)
PORT=4000

# Where uploaded sheet PDFs are stored (local disk for MVP)
FILE_STORAGE_DIR="./uploads"
