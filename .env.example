# PostgreSQL connection string.
# Local dev: any Postgres. On Vercel: use a hosted Postgres (Neon / Vercel
# Postgres / Supabase) — prefer the POOLED connection string for serverless.
DATABASE_URL="postgresql://plansimple:plansimple@localhost:5432/plansimple"

# Secret for encrypting session cookies (iron-session). MUST be at least
# 32 characters. Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-32+-char-secret!!"

# Anthropic API key for AI-assisted takeoff (AI Count / AI Suggest).
# The rest of the app works without it; AI features return a clear error if unset.
ANTHROPIC_API_KEY=""

# Claude model used for vision requests
ANTHROPIC_MODEL="claude-opus-4-8"

# --- File storage ---
# Local dev: sheet PDFs are written to FILE_STORAGE_DIR (default ./uploads).
# On Vercel: connect a Blob store to the project; Vercel injects
# BLOB_READ_WRITE_TOKEN automatically and the app switches to Vercel Blob.
FILE_STORAGE_DIR="./uploads"
# BLOB_READ_WRITE_TOKEN=""

# Unpooled/direct connection for Prisma migrations. Locally this is the same
# as DATABASE_URL; on Vercel the Neon integration injects it automatically.
DATABASE_URL_UNPOOLED="postgresql://plansimple:plansimple@localhost:5432/plansimple"
