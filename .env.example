# PlanSimple local / production environment
# Production Postgres: Neon — use pooled URL for runtime, unpooled for migrations.

NODE_ENV=development

# --- Postgres (Neon-compatible) ---
# Local Compose defaults; for Neon set both URLs from the Neon console.
DATABASE_URL=postgresql://plansimple:plansimple@localhost:5432/plansimple
DATABASE_URL_UNPOOLED=postgresql://plansimple:plansimple@localhost:5432/plansimple

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO locally; S3/R2 in prod) ---
# STORAGE_DRIVER=s3|local  (default s3 when S3_ENDPOINT set)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=plansimple
S3_SECRET_KEY=plansimplesecret
S3_BUCKET=plansimple
S3_FORCE_PATH_STYLE=true
FILE_STORAGE_DIR=./uploads
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
PUBLIC_REALTIME_URL=ws://localhost:1234

# --- Email (Mailpit locally) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=PlanSimple <noreply@plansimple.local>

# --- AI (optional; features hide when unset) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
EMBEDDING_MODEL=text-embedding-3-small

# Shared secret for docproc → API ingest callback
INGEST_CALLBACK_SECRET=dev-ingest-secret

# Feature flags (set to 1/true to enable; defaults off post-Phase-2)
# FEATURE_MARKUP_ENGINE=0
# FEATURE_REALTIME_SESSIONS=0
# FEATURE_WORKFLOWS_RFI=0

# --- Service ports ---
API_PORT=3000
WEB_PORT=5173
REALTIME_PORT=1234
DOCPROC_PORT=8001
AI_PORT=8002
